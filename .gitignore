# ==========================================
# Thathvamasi Monorepo Root .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment & Secret Files (Keep .env.example tracked)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.sock

# Temporary & Cache files
tmp/
temp/
*.tmp
.cache/

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.tox/
.nox/

# SQLite databases (if local)
*.db
*.sqlite
*.sqlite3

# Uploads & Media (keep directory structure via .gitkeep)
backend/app/static/uploads/*
!backend/app/static/uploads/.gitkeep
backend/app/static/resumes/*
!backend/app/static/resumes/.gitkeep
backend/app/static/jds/*
!backend/app/static/jds/.gitkeep

# Docker volumes
postgres_data/
pgadmin_data/
redis_data/

# ==========================================
# Frontend (Node.js / Vite)
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.pnp
.pnp.js
